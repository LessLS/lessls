# LessLS 環境配置
# 複製此檔案為 .env 並填入你的值
# 或直接設定系統環境變數

# LessLS Registry URL
# LESSLS_REGISTRY=https://registry.lessls.org

# LessLS API Base URL
# LESSLS_API_BASE=https://api.lessls.org

# GitHub 倉庫（用於 ls update github）
# LESSLS_GITHUB_REPO=lessls/lessls

# GitHub OAuth Client ID
# 前往 https://github.com/settings/developers 建立 OAuth App 後取得
# GITHUB_OAUTH_CLIENT_ID=your_github_client_id_here

# GitHub OAuth Redirect URI
# CLI 工具用 localhost 回調，不需要真實網站
# 建立 OAuth App 時填入這個網址：http://localhost:18742/oauth/callback
# GITHUB_OAUTH_REDIRECT_URI=http://localhost:18742/oauth/callback

# 版本覆蓋（編譯時使用）
# LESSLS_VERSION=0.2.0
